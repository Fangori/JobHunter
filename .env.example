# Sao chep file nay thanh `.env` (cung thu muc, canh docker-compose.yml)
# roi dien gia tri that truoc khi chay `docker compose up -d`.

# Phai co it nhat 1 chu hoa, 1 chu thuong, 1 so, 1 ky tu dac biet, toi thieu 8 ky tu (yeu cau cua SQL Server)
DB_SA_PASSWORD=Str0ng!Passw0rd

# Bat ky chuoi ngau nhien du dai (>= 32 ky tu) dung de ky JWT
JWT_KEY=doi-chuoi-nay-thanh-mot-secret-that-dai-va-ngau-nhien

# Lay tu dashboard Cloudinary (Settings > Access Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP gui email that (xac thuc dang ky UC03, quen mat khau UC06). De trong
# ca 3 dong Host/Username/Password -> tu dong fallback ve log console (mock)
# nhu truoc, khong bat buoc phai co. Vi du dung Resend (smtp.resend.com,
# port 587, username "resend", password = API key Resend).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=JobHunter

# Domain frontend that (dung de sinh link trong email) - de trong thi mac
# dinh http://localhost:5173 (dev). Doi thanh domain that khi deploy.
FRONTEND_BASE_URL=
